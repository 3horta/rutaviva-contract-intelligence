# Copia a .env solo si quieres cambiar algo. Sin .env, todo arranca en modo falso.

# Base de datos (valores de desarrollo local)
POSTGRES_USER=rutaviva
POSTGRES_PASSWORD=rutaviva
POSTGRES_DB=rutaviva
# Rol de la app (sin superusuario, sujeto a RLS); lo crea la migración inicial
APP_DB_USER=rutaviva_app
APP_DB_PASSWORD=rutaviva_app

# Puertos publicados en tu máquina (solo 127.0.0.1). La db usa 5433 para no chocar
# con un PostgreSQL local en 5432.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# Proveedores (predeterminado: modo falso, sin claves)
LLM_PROVIDER=fake                 # fake | litellm
LLM_MODEL=                        # p. ej. gemini/<modelo-flash-vigente> o groq/<modelo>
EMBEDDINGS_PROVIDER=fake          # fake | gemini
EMBEDDING_DIM=768
FAKE_LLM_MODE=ok                  # ok | invalid | invalid_once | timeout | empty
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# Claves: solo en .env, nunca versionadas
GEMINI_API_KEY=
GROQ_API_KEY=
