# Copy to .env only if you want to change something. Without .env, everything starts in fake mode.

# Database (local development values)
POSTGRES_USER=rutaviva
POSTGRES_PASSWORD=rutaviva
POSTGRES_DB=rutaviva
# App role (not a superuser, subject to RLS); created by the initial migration
APP_DB_USER=rutaviva_app
APP_DB_PASSWORD=rutaviva_app

# Ports published on your machine (127.0.0.1 only). The db uses 5433 to avoid clashing
# with a local PostgreSQL on 5432.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# Providers (default: fake mode, no keys)
LLM_PROVIDER=fake                 # fake | litellm
LLM_MODEL=                        # e.g. gemini/<current-flash-model>
EMBEDDINGS_PROVIDER=fake          # fake | gemini
EMBEDDING_DIM=768
FAKE_LLM_MODE=ok                  # ok | invalid | invalid_once | timeout | empty
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# Keys: only in .env, never committed
GEMINI_API_KEY=
