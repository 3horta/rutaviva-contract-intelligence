# Copy to .env only if you want to change something. Without .env, everything starts in fake mode.

# Database (local development values)
POSTGRES_USER=rutaviva
POSTGRES_PASSWORD=rutaviva
POSTGRES_DB=rutaviva
# App role (not a superuser, subject to RLS); created by the initial migration
APP_DB_USER=rutaviva_app
APP_DB_PASSWORD=rutaviva_app

# Ports published on your machine (127.0.0.1 only). The db uses 5433 to avoid clashing
# with a local PostgreSQL on 5432.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# Providers. Defaults need no keys: a keyless extractive LLM and a real embedding model
# that runs locally (BAAI/bge-base-en-v1.5). Switch to a real LLM with LiteLLM + a key.
LLM_PROVIDER=fake                 # fake (keyless) | litellm
LLM_MODEL=                        # litellm: e.g. gemini/gemini-3.5-flash (drafts the answer)
LLM_FAST_MODEL=                   # optional: follow-ups and relevance judge (default LLM_MODEL)
EMBEDDINGS_PROVIDER=local         # local (keyless) | gemini | fake (tests only)
EMBEDDING_DIM=768
FAKE_LLM_MODE=ok                  # ok | invalid | invalid_once | timeout | empty
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
# How a question is answered (ADR-021): auto (default) runs the LangGraph agent; with a
# real LLM Gemini chooses the tools, keyless a deterministic policy does the workflow's
# steps | workflow (the fixed pipeline, without the agent)
QUERY_MODE=auto
AGENT_MAX_STEPS=6                 # agent: model turns before it must have answered

# Reranking of the hybrid-search candidates: cross_encoder (default, a local
# ms-marco-MiniLM-L-6-v2 baked into the image) | none (keep the RRF order)
RERANKER=cross_encoder

# Text extraction: pdfplumber (default, seconds per PDF) | docling (layout model, minutes on
# a CPU; build the image with WITH_DOCLING_MODELS=true)
TEXT_EXTRACTOR=pdfplumber
WITH_DOCLING_MODELS=false

# CPU budget on small machines (PyTorch threads per service, documents in parallel)
API_TORCH_THREADS=2
WORKER_TORCH_THREADS=2
WORKER_CONCURRENCY=1

# Keys: only in .env, never committed
GEMINI_API_KEY=
